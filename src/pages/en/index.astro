---
// Experimental English-only landing page: a louder, no-nonsense pitch against gamified apps,
// previewed at /en/ before it replaces the English half of the bilingual root page.
import { loadFlashcards } from "../../data/loadFlashcards";
import { loadCardPackData } from "../../data/loadCardPacks";
import { localeUrl } from "../../lib/locale";
import { messages } from "../../lib/messages";
import FontPreload from "../../components/FontPreload.astro";
import "../../styles/landing.css";
import "../../styles/landing-en.css";

const base = import.meta.env.BASE_URL;
const appUrl = localeUrl("en");
const conversationUrl = `${appUrl}#conversation`;
const cards = loadFlashcards();
const { packs, packIdByCardId } = loadCardPackData(cards);
const cardsInPack = (packId: string) => cards.filter((card) => packIdByCardId[card.id] === packId).length;
const demoCard = cards.find((card) => card.id === "FC002")!;
const featuredPacks = [packs[0], packs[1], packs[5], packs[9]];
const meta = messages.en.metadata;
const t = messages.en;

// Each row pairs a gamification habit with what Haoly does instead.
const versus = [
  ["A streak you’re scared to break", "Come back whenever. Your progress just waits."],
  ["Hearts, gems, leagues, leaderboards", "Cards. You. Chinese. That’s the whole list."],
  ["Tap the right bubble out of four", "Recall it cold, then write your own sentence."],
  ["Push notifications with emotional damage", "Zero notifications. We couldn’t nag you if we tried."],
  ["A free trial that turns into a subscription", "Free cards, no subscription, no credit card."],
];
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={meta.description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f6f2ea" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <title>Haoly · 好礼</title>
    <script is:inline data-install-suppression>
      window.addEventListener("beforeinstallprompt", (event) => event.preventDefault());
    </script>
    <script>
      import { initLandingPage } from "../../lib/landing";
      initLandingPage();
    </script>
  </head>
  <body class="lx">
    <a class="lp-skip" href="#main">Skip to content</a>
    <header class="lp-header lp-shell">
      <a class="lp-brand" href={base} aria-label="Haoly">
        <img src={`${base}haoly-mark.png`} alt="" width="40" height="40" />
        <span>Haoly <small lang="zh-Hans">好礼</small></span>
      </a>
      <nav class="lp-nav" aria-label="Sections">
        <a href="#versus">Why not the owl?</a>
        <a href="#packs">The cards</a>
        <a href="#lei">Meet Léi</a>
      </nav>
      <div class="lp-header-tools">
        <a class="lp-button lp-button-small lp-button-ink" href={appUrl}>Open the app <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="lp-hero lp-shell" aria-labelledby="hero-title">
        <div class="lp-hero-copy">
          <p class="lx-kicker"><span>No streaks</span><span>No gems</span><span>No owl</span></p>
          <h1 id="hero-title">Learn Chinese.<br /><em>Skip the circus.</em></h1>
          <p class="lp-hero-sub">No streak to babysit. No hearts to refill. No cartoon bird guilt-tripping you at 11&nbsp;pm. Just flashcards built from real Mandarin class notes, and Léi, an AI partner who makes you write your own sentences.</p>
          <div class="lp-actions">
            <a class="lp-button lp-button-primary" href={appUrl}>Start learning. Free. <span aria-hidden="true">→</span></a>
            <a class="lp-text-link" href={conversationUrl}>Chat with Léi <span aria-hidden="true">↗</span></a>
          </div>
          <p class="lp-reassurance"><span aria-hidden="true">✓</span> No account. No credit card. No notifications. Ever.</p>
        </div>
        <div class="lp-preview-stage">
          <div class="lp-preview-grid" aria-hidden="true"></div>
          <div class="lp-preview">
            <div class="lp-preview-header"><span class="lp-preview-brand">Haoly</span><span class="lp-preview-status"><span class="lp-dot" aria-hidden="true"></span>Interactive preview</span></div>
            <div class="lp-preview-tabs" aria-hidden="true"><span class="is-active">Study</span><span>Mastered</span><span>Favorites</span></div>
            <div class="lp-demo-meta"><span>{t.directions.toHanzi}</span><span>{demoCard.id}</span></div>
            <article class="lp-demo-card">
              <p class="lp-demo-label">{t.card.promptEyebrow}</p>
              <p class="lp-demo-prompt">{demoCard.ingles}</p>
              <div class="lp-demo-placeholder" data-demo-placeholder><span class="lp-demo-cell lp-hanzi" lang="zh-Hans" aria-hidden="true"><span class="lp-demo-veil">{demoCard.hanzi}</span></span><ol class="lp-demo-steps"><li>Picture it</li><li>Say it</li><li>Check</li></ol></div>
              <div class="lp-demo-answer" id="demo-answer" hidden aria-live="polite">
                <p class="lp-demo-cell lp-hanzi" lang="zh-Hans">{demoCard.hanzi}</p>
                <p class="lp-demo-pinyin" lang="zh-Latn">{demoCard.pinyin}</p>
                <p class="lp-demo-explanation">{demoCard.explicacion_ingles}</p>
                <div class="lp-demo-example"><p class="lp-hanzi" lang="zh-Hans">{demoCard.ejemplo_hanzi}</p><p lang="zh-Latn">{demoCard.ejemplo_pinyin}</p><p>{demoCard.ejemplo_ingles}</p></div>
              </div>
              <button class="lp-demo-reveal" type="button" data-demo-reveal disabled aria-expanded="false" aria-controls="demo-answer">
                <span data-reveal-label>{t.session.reveal}</span>
                <span data-reset-label hidden>Try again</span>
                <span aria-hidden="true">↻</span>
              </button>
            </article>
          </div>
          <p class="lp-preview-caption"><span class="lp-caption-line" aria-hidden="true"></span>A real card. No confetti. Try it.</p>
        </div>
      </section>

      <div class="lp-facts lp-shell">
        <p><strong>{cards.length}</strong><span>words, phrases & concepts</span></p>
        <p><strong>{packs.length}</strong><span>packs to unlock</span></p>
        <p><strong>0</strong><span>streaks to protect</span></p>
        <p><strong>0</strong><span>guilt-trip notifications</span></p>
      </div>

      <section class="lx-versus lp-shell lp-section" id="versus" aria-labelledby="versus-title">
        <div class="lp-section-heading">
          <div><h2 id="versus-title">Gamified apps optimize for your streak.<br /><em>We optimize for your Chinese.</em></h2></div>
          <p class="lp-section-intro">Five hundred days in a row and you still can’t order noodles? That’s not you. That’s the game design. Haoly drops the slot-machine stuff and keeps the part that works: remembering things.</p>
        </div>
        <div class="lx-versus-table" role="table" aria-label="Gamified apps compared with Haoly">
          <div class="lx-versus-row lx-versus-head" role="row"><span role="columnheader">The owl app</span><span role="columnheader">Haoly</span></div>
          {versus.map(([them, us]) => (
            <div class="lx-versus-row" role="row"><span role="cell"><s>{them}</s></span><span role="cell">{us}</span></div>
          ))}
        </div>
      </section>

      <section class="lp-packs lp-shell lp-section" id="packs" aria-labelledby="packs-title">
        <div class="lp-section-heading">
          <div><h2 id="packs-title">Words you’ll actually say.<br /><em>Not “the bear drinks beer.”</em></h2></div>
          <p class="lp-section-intro">Every card comes from real Mandarin classes: ordering, family, small talk, the grammar that trips everyone up. Your first pack is already open. Unlock the next when you’re ready, not when an algorithm says so.</p>
        </div>
        <div class="lp-pack-grid">
          {featuredPacks.map((pack, index) => (
            <article class="lp-pack" data-theme={pack.theme}>
              <div class="lp-pack-top"><span class="lp-pack-number">{String(packs.indexOf(pack) + 1).padStart(2, "0")}</span><span class="lp-pack-state">{index === 0 ? "Open now" : "To unlock"}</span></div>
              <span class="lp-pack-mark lp-hanzi" lang="zh-Hans">{pack.mark}</span>
              <h3>{pack.title.en}</h3>
              <p>{pack.description.en}</p>
              <div class="lp-pack-bottom"><span>{cardsInPack(pack.id)} cards</span><span lang="zh-Hans" aria-hidden="true">好礼</span></div>
            </article>
          ))}
        </div>
        <p class="lp-pack-link"><a class="lp-text-link" href={appUrl}>See all {packs.length} packs in the app <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="lp-method lp-shell lp-section" aria-labelledby="method-title">
        <div class="lp-section-heading"><div><h2 id="method-title">Three things.<br /><em>Done properly.</em></h2></div><p class="lp-section-intro">One card at a time. You decide what you know and what needs more work. No XP, no levels, no mascot doing a little dance.</p></div>
        <div class="lp-method-grid">
          <article><span class="lp-feature-mark lp-hanzi" lang="zh-Hans" aria-hidden="true">忆</span><h3>Recall, don’t recognize</h3><p>Think before you reveal. Practice both directions, and drill the grammar rules themselves with concept cards.</p></article>
          <article><span class="lp-feature-mark" aria-hidden="true">☆</span><h3>Your deck, your call</h3><p>Move what you know to Mastered. Star what you keep forgetting. Search and filter when you need one specific card.</p></article>
          <article><span class="lp-feature-mark lp-hanzi" lang="zh-Hans" aria-hidden="true">听</span><h3>Hear it. Say it.</h3><p>Pinyin on every card, and pronunciation from the Chinese voices on your device. Or study in silence on the bus.</p></article>
        </div>
      </section>

      <section class="lp-lei" id="lei" aria-labelledby="lei-title">
        <div class="lp-shell lp-lei-inner">
          <div class="lp-lei-copy">
            <h2 id="lei-title">Multiple choice is a crutch.<br /><em>Léi makes you write.</em></h2>
            <p>Order tea. Talk about your family. Say what you like. Léi, your AI conversation partner, asks in Chinese and you answer with your own sentence, built from the words you’re learning. Get it wrong and you find out why.</p>
            <ul class="lp-lei-features">
              <li><span aria-hidden="true">↳</span><span>Short conversations, on a topic you pick.</span></li>
              <li><span aria-hidden="true">↳</span><span>Pinyin, translation, and a possible answer when you’re stuck.</span></li>
              <li><span aria-hidden="true">↳</span><span>Honest corrections, explained in plain English.</span></li>
            </ul>
            <a class="lp-button lp-button-light" href={conversationUrl}>Try a conversation <span aria-hidden="true">↗</span></a>
            <p class="lp-lei-note">Three messages free, no account. Then keep chatting free with Google sign-in, within usage limits. Internet required.</p>
          </div>
          <figure class="lp-chat-example">
            <figcaption><span class="lp-chat-seal lp-hanzi" lang="zh-Hans" aria-hidden="true">雷</span><span><strong>Léi</strong><small>Conversation partner</small></span><span class="lp-example-label">Example</span></figcaption>
            <div class="lp-chat-line"><span class="lp-speaker">Léi</span><p class="lp-hanzi" lang="zh-Hans">你喜欢喝茶吗？</p><details class="lp-chat-help"><summary>Pinyin & translation</summary><p class="lp-ruby lp-hanzi" lang="zh-Hans"><ruby>你<rt>nǐ</rt></ruby><ruby>喜<rt>xǐ</rt></ruby><ruby>欢<rt>huān</rt></ruby><ruby>喝<rt>hē</rt></ruby><ruby>茶<rt>chá</rt></ruby><ruby>吗<rt>ma</rt></ruby>？</p><p>Do you like drinking tea?</p></details></div>
            <div class="lp-chat-answer"><span class="lp-speaker">You</span><p class="lp-hanzi" lang="zh-Hans">我喝喜欢茶。</p><details class="lp-naturalness"><summary>Needs work<span aria-hidden="true">⌄</span></summary><p>Put 喜欢 (xǐhuān — to like) before 喝 (hē — to drink).</p><p class="lp-hanzi" lang="zh-Hans">我喜欢喝茶。</p></details></div>
            <div class="lp-chat-line"><span class="lp-speaker">Léi</span><p class="lp-hanzi" lang="zh-Hans">你喜欢喝什么茶？</p><p class="lp-chat-translation">What tea do you like drinking?</p></div>
            <div class="lp-chat-question"><span aria-hidden="true">?</span><p>Grammar question? Ask it. Léi explains in English.</p></div>
          </figure>
        </div>
      </section>

      <section class="lp-practical lp-shell lp-section" aria-labelledby="practical-title">
        <div><h2 id="practical-title">Free.<br /><em>Actually free.</em></h2><p class="lp-practical-benefit">No trial clock, no paywall at lesson six, no “Super” tier. Open the app and start with your first word. Study without an account, star the tricky bits, and come back whenever. Your progress will be waiting. A guilt-trip notification won’t.</p></div>
        <div class="lp-faq">
          <details><summary>Really free?<span aria-hidden="true">+</span></summary><p>Yes. Cards and packs are free, with no subscription. Léi is free too, with usage limits: try three messages without an account, then sign in with Google to continue.</p></details>
          <details open><summary>Do I need an account?<span aria-hidden="true">+</span></summary><p>Not to study. Your progress, favorites, and open packs are saved on this device. Sign in with Google if you want to sync them across devices.</p></details>
          <details><summary>Can I study offline?<span aria-hidden="true">+</span></summary><p>Yes, cards work offline after the app has loaded. Chatting with Léi and signing in need internet.</p></details>
          <details><summary>Where are my conversations saved?<span aria-hidden="true">+</span></summary><p>The latest twelve exchanges stay in your browser, separated by account and language. During chat, bounded history and vocabulary are sent to the AI service; transcripts aren’t stored in Firestore or Haoly’s backend.</p></details>
        </div>
      </section>

      <section class="lp-closing lp-shell" aria-labelledby="closing-title"><span class="lp-closing-mark lp-hanzi" lang="zh-Hans" aria-hidden="true">学</span><div><h2 id="closing-title">Your streak doesn’t speak Chinese.<br /><em>You could.</em></h2><p class="lp-closing-note">Learn one word today. Close the app. That counts.</p></div><a class="lp-button lp-button-primary" href={appUrl}>Open Haoly <span aria-hidden="true">→</span></a></section>
    </main>
    <footer class="lp-footer lp-shell"><a class="lp-brand" href={base}>Haoly <small lang="zh-Hans">好礼</small></a><p>Created by <a href="https://janbalanya.com/">Jan Balanyà Scholl</a></p><a href="#main">Back to top ↑</a></footer>
    <noscript><p class="lp-noscript">Enable JavaScript to try the card. <a href={appUrl}>Open the app</a></p></noscript>
  </body>
</html>
