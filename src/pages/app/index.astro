---
// Old Home Screen shortcuts were installed with start_url /app/; keep them launching.
import { appLaunchResolverScript, localeUrl } from "../../lib/locale";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <script is:inline data-app-launch set:html={appLaunchResolverScript()} />
    <title>Haoly</title>
  </head>
  <body>
    <p><a href={localeUrl("es")} lang="es">Abrir las cartas</a></p>
    <p><a href={localeUrl("en")} lang="en">Open the cards</a></p>
  </body>
</html>
