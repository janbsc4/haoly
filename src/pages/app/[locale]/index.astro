---
// The app moved from /app/<locale>/ to /study/<locale>/; forward old links.
import { SUPPORTED_LOCALES, legacyLocaleRedirectScript, localeUrl } from "../../../lib/locale";
import type { Locale } from "../../../types";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const target = localeUrl(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <script is:inline data-legacy-redirect set:html={legacyLocaleRedirectScript(locale)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>Haoly</title>
  </head>
  <body>
    <p><a href={target}>Haoly</a></p>
  </body>
</html>
